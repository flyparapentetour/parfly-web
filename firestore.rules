rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Public catalog content — read by visitors, write only by admins.
    match /services/{id}           { allow read; allow write: if isSignedIn(); }
    match /additionals/{id}        { allow read; allow write: if isSignedIn(); }
    match /testimonials/{id}       { allow read; allow write: if isSignedIn(); }
    match /gallery/{id}            { allow read; allow write: if isSignedIn(); }

    // Settings: generic is public (whatsapp, socials); Bold MUST be admin-only
    // because it stores the secretKey.
    match /settings/general        { allow read; allow write: if isSignedIn(); }
    match /settings/legal          { allow read; allow write: if isSignedIn(); }
    match /settings/schedule       { allow read; allow write: if isSignedIn(); }
    match /settings/stats          { allow read; allow write: if isSignedIn(); }
    match /settings/faq            { allow read; allow write: if isSignedIn(); }
    match /settings/homeIntros     { allow read; allow write: if isSignedIn(); }
    match /settings/included       { allow read; allow write: if isSignedIn(); }
    match /settings/classes        { allow read; allow write: if isSignedIn(); }
    match /settings/sedes          { allow read; allow write: if isSignedIn(); }
    match /settings/bold           { allow read, write: if isSignedIn(); }

    // Availability tree: public read, admin write.
    match /availability/{sede}/slots/{date} {
      allow read;
      allow write: if isSignedIn();
    }

    // Blocked dates: public read (booking flow checks), admin write.
    match /blocked/{sede}/dates/{date} {
      allow read;
      allow write: if isSignedIn();
    }

    // Bookings: visitors can create their own y `get` el suyo (por ID
    // conocido — el ID actúa como token de acceso, solo lo recibe quien
    // creó la reserva). `list` y mutaciones siguen siendo admin-only.
    // `paymentStatus`, `boldEventId`, `boldPaidAt` etc. los escribe SOLO la
    // Cloud Function `boldWebhook` (admin SDK, bypassa estas rules).
    match /bookings/{id} {
      allow create;
      allow get;
      allow list, update, delete: if isSignedIn();
    }

    // boldEvents: store de idempotencia del webhook de Bold. Solo la
    // Cloud Function lo toca (vía admin SDK). Cliente y admin no
    // deben leer ni escribir aquí.
    match /boldEvents/{id} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
